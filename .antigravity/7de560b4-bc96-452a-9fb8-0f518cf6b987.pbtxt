            lines {
              text: "          id: createUid(\'blk\'),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          type: \'two-column-text\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          text: \'When contemporary buildings rely on synthetic cladding systems, they sever the relationship between structural mass and atmospheric perception. In our studio methodology, every wall thickness is calibrated first by thermal inertia and acoustic attenuation, and second by the depth of shadow it casts at equinox.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          secondaryText: \'Across twelve realized commissions in Switzerland, Spain, and Denmark, we have restricted our palette to four primary materials: board-formed limestone concrete, untreated European oak, raw anodized aluminum, and lime-washed brick.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
