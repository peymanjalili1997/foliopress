  planner_response {
    response: "\330\247\330\250\330\262\330\247\330\261 **FolioPress \342\200\224 PDF Portfolio Builder** \330\250\330\247 \330\267\330\261\330\247\330\255\333\214 \332\251\330\247\331\205\331\204\330\247\331\213 \330\247\331\206\332\257\331\204\333\214\330\263\333\214 \331\210 \332\206\331\276\342\200\214\332\206\333\214\331\206 (LTR) \330\242\331\205\330\247\330\257\331\207 \330\247\330\263\330\252:\n\n- **\331\205\330\257\333\214\330\261\333\214\330\252 \330\265\331\201\330\255\331\207\342\200\214\330\250\331\207\342\200\214\330\265\331\201\330\255\331\207 \331\210 \330\252\330\272\333\214\333\214\330\261 \330\252\330\261\330\252\333\214\330\250 (Pages & Spread Reorder):** \330\247\331\205\332\251\330\247\331\206 \330\247\331\201\330\262\331\210\330\257\331\206 \331\206\330\247\331\205\330\255\330\257\331\210\330\257 \330\265\331\201\330\255\330\247\330\252 \330\254\330\257\333\214\330\257\330\214 \332\251\331\276\333\214 \333\214\330\247 \330\255\330\260\331\201 \330\265\331\201\330\255\330\247\330\252\330\214 \331\210 \330\254\330\247\330\250\331\207\342\200\214\330\254\330\247\333\214\333\214 \330\252\330\261\330\252\333\214\330\250 \330\242\331\206\342\200\214\331\207\330\247 \330\250\330\247 Drag & Drop \333\214\330\247 \330\257\332\251\331\205\331\207\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247/\331\276\330\247\333\214\333\214\331\206 \331\207\331\205 \330\257\330\261 \331\276\331\206\331\204 \330\263\331\205\330\252 \332\206\331\276 \331\210 \331\207\331\205 \330\257\330\261 \331\206\331\205\330\247\333\214 \332\251\331\204\333\214 **Spread Reorder**.\n- **\332\251\330\252\330\247\330\250\330\256\330\247\331\206\331\207 \331\201\331\210\331\206\330\252\342\200\214\331\207\330\247\333\214 \330\247\331\206\332\257\331\204\333\214\330\263\333\214 \331\210 \330\247\330\250\330\262\330\247\330\261 \331\210\333\214\330\261\330\247\333\214\330\264 \331\205\330\252\331\206:** \331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \330\247\330\262 \333\261\333\266 \331\201\331\210\331\206\330\252 \330\247\331\206\332\257\331\204\333\214\330\263\333\214 \331\205\331\206\330\252\330\256\330\250 \330\257\330\261 \333\264 \330\257\330\263\330\252\331\207 (*Editorial Serif*, *Architectural Sans*, *Display & Avant-Garde*, *Technical Mono*) \331\207\331\205\330\261\330\247\331\207 \330\250\330\247 \331\206\331\210\330\247\330\261 \330\247\330\250\330\262\330\247\330\261 \332\251\330\247\331\205\331\204 \331\210\333\214\330\261\330\247\333\214\330\264 \331\205\330\252\331\206 (\330\252\330\272\333\214\333\214\330\261 \331\201\331\210\331\206\330\252\330\214 \330\263\330\247\333\214\330\262\330\214 \331\210\330\262\331\206\330\214 Bold/Italic/Underline\330\214 \330\252\330\261\330\247\330\262 \332\206\331\276/\331\210\330\263\330\267/\330\261\330\247\330\263\330\252/Justify\330\214 \331\201\330\247\330\265\331\204\331\207 \330\256\330\267\331\210\330\267\330\214 \331\201\330\247\330\265\331\204\331\207 \330\255\330\261\331\210\331\201 \331\210 \330\261\331\206\332\257).\n- **\330\247\331\201\330\262\331\210\330\257\331\206 \330\271\332\251\330\263 \331\210 \330\250\331\204\331\210\332\251\342\200\214\331\207\330\247\333\214 \331\205\330\255\330\252\331\210\330\247\333\214\333\214 \330\257\330\261 \331\207\330\261 \330\265\331\201\330\255\331\207:** \330\247\331\205\332\251\330\247\331\206 \330\242\331\276\331\204\331\210\330\257 \331\205\330\263\330\252\331\202\333\214\331\205 \330\252\330\265\331\210\333\214\330\261 \330\247\330\262 \330\263\333\214\330\263\330\252\331\205 (\333\214\330\247 Drag & Drop \330\261\331\210\333\214 \331\207\330\261 \332\251\330\247\330\257\330\261 \330\252\330\265\331\210\333\214\330\261)\330\214 \330\252\331\206\330\270\333\214\331\205 \330\247\330\261\330\252\331\201\330\247\330\271\330\214 \330\250\330\261\330\264/\330\262\331\210\331\205\330\214 \331\201\333\214\331\204\330\252\330\261\331\207\330\247\333\214 \331\206\331\210\330\261\333\214 (Monochrome\330\214 Warm Archival\330\214 High Contrast)\330\214 \330\262\333\214\330\261\331\206\331\210\333\214\330\263 \330\271\332\251\330\263 \331\210 \330\247\331\201\330\262\331\210\330\257\331\206 \330\250\331\204\331\210\332\251\342\200\214\331\207\330\247\333\214 \331\205\330\252\331\206\331\210\330\271 (`Heading`, `Text`, `Image`, `Image + Text`, `Dual Image`, `2-Col Text`, `Quote`, `Specs`).\n- **\331\202\330\247\331\204\330\250\342\200\214\330\250\331\206\330\257\333\214 \332\251\331\204\333\214 \331\210 \330\252\331\205\342\200\214\331\207\330\247\333\214 \330\242\331\205\330\247\330\257\331\207 (Global Styling & Templates):** \330\252\331\206\330\270\333\214\331\205 \330\247\330\250\330\271\330\247\330\257 \332\251\331\204\333\214 \330\263\331\206\330\257 (`A4 Portrait`, `A4 Landscape`, `US Letter`, `16:9 Presentation`)\330\214 \330\247\331\206\330\252\330\256\330\247\330\250 \330\261\331\206\332\257 \332\251\330\247\330\272\330\260 \331\210 \330\252\331\205 \332\251\331\204\333\214\330\214 \330\247\330\271\331\205\330\247\331\204 \333\214\332\251\331\276\330\247\330\261\332\206\331\207 \330\262\331\210\330\254\342\200\214\331\201\331\210\331\206\330\252\342\200\214\331\207\330\247 \330\261\331\210\333\214 \330\252\331\205\330\247\331\205 \330\265\331\201\330\255\330\247\330\252\330\214 \330\252\331\206\330\270\333\214\331\205 \330\255\330\247\330\264\333\214\331\207\342\200\214\331\207\330\247 (Margins)\330\214 \331\207\330\257\330\261 \331\210 \331\201\331\210\330\252\330\261\330\214 \331\210 \330\264\331\205\330\247\330\261\331\207\342\200\214\332\257\330\260\330\247\330\261\333\214 \330\256\331\210\330\257\332\251\330\247\330\261 \330\265\331\201\330\255\330\247\330\252.\n- **\330\256\330\261\331\210\330\254\333\214 PDF \330\250\330\247 \332\251\333\214\331\201\333\214\330\252 \330\250\330\247\331\204\330\247 (High-Res PDF Export):** \330\256\330\261\331\210\330\254\333\214 \331\205\330\263\330\252\331\202\333\214\331\205 \331\201\330\247\333\214\331\204 PDF \332\206\331\206\330\257\330\265\331\201\330\255\331\207\342\200\214\330\247\333\214 \330\250\330\247 \330\247\331\205\332\251\330\247\331\206 \330\247\331\206\330\252\330\256\330\247\330\250 \332\251\333\214\331\201\333\214\330\252 \330\261\331\206\330\257\330\261 \330\252\330\247 **300+ DPI (Print Master 3x Supersampled)** \331\210 \331\207\331\205\332\206\331\206\333\214\331\206 \331\276\330\264\330\252\333\214\330\250\330\247\331\206\333\214 \330\247\330\262 **Vector Print PDF**."
    modified_response: "\330\247\330\250\330\262\330\247\330\261 **FolioPress \342\200\224 PDF Portfolio Builder** \330\250\330\247 \330\267\330\261\330\247\330\255\333\214 \332\251\330\247\331\205\331\204\330\247\331\213 \330\247\331\206\332\257\331\204\333\214\330\263\333\214 \331\210 \332\206\331\276\342\200\214\332\206\333\214\331\206 (LTR) \330\242\331\205\330\247\330\257\331\207 \330\247\330\263\330\252:\n\n- **\331\205\330\257\333\214\330\261\333\214\330\252 \330\265\331\201\330\255\331\207\342\200\214\330\250\331\207\342\200\214\330\265\331\201\330\255\331\207 \331\210 \330\252\330\272\333\214\333\214\330\261 \330\252\330\261\330\252\333\214\330\250 (Pages & Spread Reorder):** \330\247\331\205\332\251\330\247\331\206 \330\247\331\201\330\262\331\210\330\257\331\206 \331\206\330\247\331\205\330\255\330\257\331\210\330\257 \330\265\331\201\330\255\330\247\330\252 \330\254\330\257\333\214\330\257\330\214 \332\251\331\276\333\214 \333\214\330\247 \330\255\330\260\331\201 \330\265\331\201\330\255\330\247\330\252\330\214 \331\210 \330\254\330\247\330\250\331\207\342\200\214\330\254\330\247\333\214\333\214 \330\252\330\261\330\252\333\214\330\250 \330\242\331\206\342\200\214\331\207\330\247 \330\250\330\247 Drag & Drop \333\214\330\247 \330\257\332\251\331\205\331\207\342\200\214\331\207\330\247\333\214 \330\250\330\247\331\204\330\247/\331\276\330\247\333\214\333\214\331\206 \331\207\331\205 \330\257\330\261 \331\276\331\206\331\204 \330\263\331\205\330\252 \332\206\331\276 \331\210 \331\207\331\205 \330\257\330\261 \331\206\331\205\330\247\333\214 \332\251\331\204\333\214 **Spread Reorder**.\n- **\332\251\330\252\330\247\330\250\330\256\330\247\331\206\331\207 \331\201\331\210\331\206\330\252\342\200\214\331\207\330\247\333\214 \330\247\331\206\332\257\331\204\333\214\330\263\333\214 \331\210 \330\247\330\250\330\262\330\247\330\261 \331\210\333\214\330\261\330\247\333\214\330\264 \331\205\330\252\331\206:** \331\276\330\264\330\252\333\214\330\250\330\247\331\20