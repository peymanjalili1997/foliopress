            lines {
              text: "          type: \'pull-quote\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          text: \'\342\200\234True permanence is not resistance to time, but the capacity of raw stone and timber to record the passage of light with dignity.\342\200\235\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          kicker: \'\342\200\224 JULIAN VANCE, ETH ZURICH LECTURE SERIES\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
